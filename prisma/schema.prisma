generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  password      String?
  image         String?
  role          Role          @default(USER)
  emailVerified DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  bookings      Booking[]
  invoices      Invoice[]
  properties    Property[]
  reviews       Review[]
  sessions      Session[]
  profile       UserProfile?
  settings      UserSettings?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

model AppCredential {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  updatedAt      DateTime @updatedAt

  @@map("app_credentials")
}

model UserProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  phone      String?
  company    String?
  address    String?
  city       String?
  postalCode String?
  country    String?
  website    String?
  bio        String?
  timezone   String   @default("Europe/Paris")
  language   String   @default("fr")
  currency   String   @default("EUR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  twoFactorEnabled   Boolean  @default(false)
  autoBackupEnabled  Boolean  @default(true)
  backupFrequency    String   @default("daily")
  backupTime         String   @default("03:00")
  retentionDays      Int      @default(30)
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  pushNotifications  Boolean  @default(true)
  dateFormat         String   @default("DD/MM/YYYY")
  timeFormat         String   @default("24h")
  numberFormat       String   @default("space")
  firstDayOfWeek     Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Property {
  id             Int                  @id @default(autoincrement())
  name           String
  address        String
  city           String
  country        String
  description    String?
  capacity       Int
  bedrooms       Int
  bathrooms      Int
  price          Float
  currency       String               @default("EUR")
  status         PropertyStatus       @default(ACTIVE)
  userId         String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  amenities      String[]             @default([])
  cleaningFee    Float                @default(0)
  externalId     String?
  externalSource String?
  images         String[]             @default([])
  maxGuests      Int?
  metadata       Json?
  pricePerNight  Float?
  type           String?
  zipCode        String?
  accessCodes    AccessCode[]
  bookings       Booking[]
  cleanings      Cleaning[]
  contracts      Contract[]
  expenses       Expense[]
  inventory      InventoryItem[]
  maintenance    MaintenanceTask[]
  messageThreads MessageThread[]
  photos         Photo[]
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspections    PropertyInspection[]
  reviews        Review[]
  videos         Video[]
  invoices       Invoice[]

  @@map("properties")
}

model Booking {
  id                 Int           @id @default(autoincrement())
  propertyId         Int
  userId             String?
  guestName          String
  guestEmail         String
  guestPhone         String?
  checkIn            DateTime
  checkOut           DateTime
  guests             Int
  totalPrice         Float
  status             BookingStatus @default(PENDING)
  source             BookingSource @default(DIRECT)
  externalId         String?
  notes              String?
  specialRequests    String?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  confirmationCode   String?
  externalSource     String?
  metadata           Json?
  property           Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user               User?         @relation(fields: [userId], references: [id])
  payments           Payment[]
  reviews            Review[]
  invoices           Invoice[]

  @@index([propertyId])
  @@index([checkIn, checkOut])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int
  amount        Float
  currency      String        @default("EUR")
  status        PaymentStatus @default(PENDING)
  method        PaymentMethod
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id         Int      @id @default(autoincrement())
  propertyId Int
  bookingId  Int?
  userId     String?
  guestName  String
  rating     Int
  comment    String?
  isPublic   Boolean  @default(true)
  source     String   @default("DIRECT")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  booking    Booking? @relation(fields: [bookingId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Photo {
  id         Int      @id @default(autoincrement())
  propertyId Int
  url        String
  publicId   String?
  caption    String?
  category   String?
  order      Int      @default(0)
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("photos")
}

model Video {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  filename    String
  title       String?
  description String?
  duration    Int?
  size        Int?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("videos")
}

model Cleaning {
  id            Int            @id @default(autoincrement())
  propertyId    Int
  scheduledDate DateTime
  completedDate DateTime?
  status        CleaningStatus @default(SCHEDULED)
  assignedTo    String?
  checklist     Json?
  notes         String?
  estimatedTime Int?
  actualTime    Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([scheduledDate])
  @@map("cleanings")
}

model MaintenanceTask {
  id          Int                 @id @default(autoincrement())
  propertyId  Int
  title       String
  description String?
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus   @default(PENDING)
  category    String?
  assignedTo  String?
  dueDate     DateTime?
  completedAt DateTime?
  cost        Float?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  property    Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
  @@map("maintenance_tasks")
}

model InventoryItem {
  id          Int       @id @default(autoincrement())
  propertyId  Int
  name        String
  category    String
  quantity    Int
  minQuantity Int       @default(0)
  unit        String?
  location    String?
  notes       String?
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("inventory_items")
}

model Contract {
  id          Int            @id @default(autoincrement())
  propertyId  Int
  tenantName  String
  tenantEmail String
  startDate   DateTime
  endDate     DateTime
  rentAmount  Float
  deposit     Float?
  status      ContractStatus @default(ACTIVE)
  signedAt    DateTime?
  pdfUrl      String?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("contracts")
}

model IntegrationSetting {
  id             String    @id @default(cuid())
  platform       String    @unique
  enabled        Boolean   @default(false)
  apiKey         String?
  apiSecret      String?
  icalUrl        String?
  hotelId        String?
  lastSyncAt     DateTime?
  syncStatus     String?
  config         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?

  @@map("integration_settings")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  category  String
  type      String
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  push      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model NotificationLog {
  id      String   @id @default(cuid())
  userId  String?
  type    String
  channel String
  subject String?
  message String
  sentAt  DateTime @default(now())
  status  String
  error   String?

  @@index([userId])
  @@index([sentAt])
  @@map("notification_logs")
}

model Backup {
  id        String       @id @default(cuid())
  name      String
  type      BackupType   @default(MANUAL)
  status    BackupStatus @default(COMPLETED)
  size      Int?
  path      String?
  createdAt DateTime     @default(now())

  @@map("backups")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  eventData Json?
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@map("analytics_events")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model Expense {
  id            Int             @id @default(autoincrement())
  propertyId    Int?
  title         String
  description   String?
  amount        Float
  currency      String          @default("EUR")
  category      ExpenseCategory
  date          DateTime
  vendor        String?
  receiptUrl    String?
  paymentMethod String?
  isRecurring   Boolean         @default(false)
  recurrence    String?
  notes         String?
  createdBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  property      Property?       @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

model PropertyInspection {
  id          Int              @id @default(autoincrement())
  propertyId  Int
  bookingId   Int?
  type        InspectionType
  status      InspectionStatus @default(DRAFT)
  date        DateTime
  inspector   String?
  guestName   String?
  guestEmail  String?
  notes       String?
  signature   String?
  signedAt    DateTime?
  rooms       Json?
  globalScore Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  property    Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([bookingId])
  @@index([type])
  @@map("property_inspections")
}

model AccessCode {
  id          Int            @id @default(autoincrement())
  propertyId  Int
  bookingId   Int?
  label       String
  code        String
  type        AccessCodeType @default(DOOR_CODE)
  validFrom   DateTime?
  validUntil  DateTime?
  isActive    Boolean        @default(true)
  sentByEmail Boolean        @default(false)
  sentAt      DateTime?
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([bookingId])
  @@map("access_codes")
}

model MessageThread {
  id            Int       @id @default(autoincrement())
  platform      String
  externalId    String?
  propertyId    Int?
  bookingId     Int?
  guestName     String
  guestEmail    String?
  subject       String?
  lastMessage   String?
  lastMessageAt DateTime  @default(now())
  isRead        Boolean   @default(false)
  isArchived    Boolean   @default(false)
  autoReplied   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property? @relation(fields: [propertyId], references: [id])
  messages      Message[]

  @@index([platform])
  @@index([propertyId])
  @@index([isRead])
  @@index([lastMessageAt])
  @@map("message_threads")
}

model Message {
  id         Int           @id @default(autoincrement())
  threadId   Int
  content    String
  senderType String
  senderName String?
  isAI       Boolean       @default(false)
  createdAt  DateTime      @default(now())
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("messages")
}

model WebVital {
  id        String   @id @default(cuid())
  name      String
  value     Float
  rating    String
  page      String?
  userId    String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([name])
  @@index([timestamp])
  @@index([page])
  @@map("web_vitals")
}

enum Role {
  USER
  ADMIN
  EMPLOYEE
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum BookingSource {
  DIRECT
  AIRBNB
  BOOKING_COM
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  PAYPAL
  STRIPE
}

enum CleaningStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BackupType {
  MANUAL
  AUTOMATIC
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ExpenseCategory {
  CLEANING
  MAINTENANCE
  UTILITIES
  INSURANCE
  TAX
  MORTGAGE
  FURNITURE
  SUPPLIES
  MARKETING
  MANAGEMENT
  RENOVATION
  SUBSCRIPTION
  OTHER
}

enum InspectionType {
  CHECKIN
  CHECKOUT
  PERIODIC
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SIGNED
}

enum AccessCodeType {
  DOOR_CODE
  KEY_BOX
  SMART_LOCK
  WIFI
  PARKING
  GATE
  OTHER
}

model Invoice {
  id           String @id @default(cuid())
  number       String @unique
  status       String @default("draft")
  documentType String @default("invoice")

  issuerName    String
  issuerAddress String
  issuerCity    String
  issuerZip     String
  issuerCountry String
  issuerEmail   String
  issuerPhone   String
  issuerSiret   String?
  issuerVat     String?
  issuerLogo    String?

  clientName    String
  clientAddress String
  clientCity    String
  clientZip     String
  clientCountry String
  clientEmail   String
  clientPhone   String?
  clientRef     String?

  userId     String
  propertyId Int?
  bookingId  Int?

  issueDate DateTime
  dueDate   DateTime

  globalDiscount Float @default(0)

  notes         String? @db.Text
  internalNotes String? @db.Text
  paymentTerms  String? @db.Text

  accentColor String? @default("#2563EB")
  layout      String  @default("classic")

  signatureName String?
  signatureDate DateTime?

  partialPayments Json? @default("[]")
  statusHistory   Json? @default("[]")
  tags            Json? @default("[]")

  isRecurring        Boolean @default(false)
  recurringFrequency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  booking  Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]

  @@index([userId])
  @@index([status])
  @@index([documentType])
  @@map("invoices")
}

model InvoiceLine {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  vatRate     Float  @default(0)
  discount    Float  @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}
